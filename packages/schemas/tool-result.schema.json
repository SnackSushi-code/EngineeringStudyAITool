{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ann-e.local/schemas/tool-result.schema.json",
  "title": "Ann-E ToolResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "task_id",
    "status",
    "result",
    "artifacts",
    "validation",
    "provenance",
    "error",
    "logs"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.json#/$defs/schemaVersion"
    },
    "request_id": {
      "$ref": "common.json#/$defs/uuid"
    },
    "task_id": {
      "$ref": "common.json#/$defs/uuid"
    },
    "status": {
      "$ref": "common.json#/$defs/taskTerminalState"
    },
    "result": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "checks"
      ],
      "properties": {
        "state": {
          "$ref": "common.json#/$defs/validationState"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_version",
        "adapter_version"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "error": {
      "anyOf": [
        {
          "$ref": "error.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
