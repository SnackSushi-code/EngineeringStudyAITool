{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ann-e.local/schemas/memory.schema.json",
  "title": "Ann-E Memory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_id",
    "layer",
    "content",
    "source_refs",
    "confidence",
    "created_at",
    "last_validated_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.json#/$defs/schemaVersion"
    },
    "memory_id": {
      "$ref": "common.json#/$defs/uuid"
    },
    "layer": {
      "type": "string",
      "enum": [
        "SESSION",
        "USER",
        "PROJECT",
        "ENGINEERING",
        "STUDY",
        "RESEARCH",
        "SYSTEM"
      ]
    },
    "content": {},
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "last_validated_at": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "APPROVED",
        "STALE",
        "REVOKED"
      ]
    }
  }
}
