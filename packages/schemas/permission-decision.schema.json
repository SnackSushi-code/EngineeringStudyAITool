{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ann-e.local/schemas/permission-decision.schema.json",
  "title": "Ann-E PermissionDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "approval_id",
    "policy_version",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.json#/$defs/schemaVersion"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL"
      ]
    },
    "approval_id": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
